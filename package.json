{
  "name": "virtu-capital-help-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "start:user": "docusaurus start",
    "start:admin": "npm --prefix admin-guide start",
    "build": "docusaurus build",
    "build:user": "docusaurus build",
    "build:admin": "npm --prefix admin-guide run build",
    "build:all": "npm run build:user && npm run build:admin",
    "build:github-pages": "rm -rf build admin-guide/build && DEPLOY_TARGET=github-pages npm run build:user && DEPLOY_TARGET=github-pages npm run build:admin && mkdir -p build/admin && cp -R admin-guide/build/* build/admin/ && touch build/.nojekyll",
    "deploy:github-pages": "npm run build:github-pages && gh-pages -d build",
    "publish": "bash scripts/publish-guides.sh",
    "serve": "docusaurus serve"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/plugin-client-redirects": "3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@mdx-js/react": "3.1.0",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
