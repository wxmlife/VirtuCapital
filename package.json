{
  "name": "virtu-capital-help-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "start:user": "docusaurus start",
    "preview:user": "DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-preview docusaurus clear && DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-preview docusaurus serve --build --host 0.0.0.0",
    "start:admin": "npm --prefix admin-guide run start --",
    "preview:admin": "npm --prefix admin-guide run preview",
    "build": "DOCUSAURUS_GENERATED_FILES_DIR_NAME=${DOCUSAURUS_GENERATED_FILES_DIR_NAME:-.docusaurus-build} docusaurus build",
    "build:user": "DOCUSAURUS_GENERATED_FILES_DIR_NAME=${DOCUSAURUS_GENERATED_FILES_DIR_NAME:-.docusaurus-build} docusaurus build",
    "build:admin": "npm --prefix admin-guide run build",
    "build:all": "npm run build:user && npm run build:admin",
    "build:github-pages": "bash scripts/build-github-pages.sh",
    "deploy:github-pages": "npm run build:github-pages && gh-pages -d build",
    "check:doc-assets": "node scripts/check-doc-assets.mjs",
    "check:built-site": "node scripts/check-built-site.mjs",
    "check:admin-routes": "npm --prefix admin-guide run check:routes",
    "publish": "bash scripts/publish-guides.sh",
    "serve": "docusaurus serve"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/plugin-client-redirects": "3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@mdx-js/react": "3.1.0",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
